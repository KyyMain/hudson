<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hudson_pool_tree" model="ir.ui.view">
        <field name="name">hudson.pool.tree</field>
        <field name="model">hudson.pool</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="cleaning_type_id"/>
                <field name="state"/>
                <field name="next_cleaning_date"/>
                <field name="cleaning_job_count"/>
            </tree>
        </field>
    </record>

    <record id="hudson_pool_form" model="ir.ui.view">
        <field name="name">hudson.pool.form</field>
        <field name="model">hudson.pool</field>
        <field name="arch" type="xml">
            <form string="Data Kolam">
                <sheet>
                    <header>
                        <button name="action_open_cleaning_jobs" type="object" string="Riwayat" class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="cleaning_type_id"/>
                            <field name="water_type"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="next_cleaning_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ukuran">
                            <group>
                                <field name="size_m2"/>
                                <field name="length"/>
                                <field name="width"/>
                                <field name="depth"/>
                            </group>
                        </page>
                        <page string="Pembersihan">
                            <field name="cleaning_job_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                    <field name="cleaning_type_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hudson_pool_search" model="ir.ui.view">
        <field name="name">hudson.pool.search</field>
        <field name="model">hudson.pool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Kolam"/>
                <field name="customer_id"/>
                <field name="cleaning_type_id"/>
                <filter string="Terjadwal" name="scheduled" domain="[('state','=','scheduled')]"/>
                <filter string="Sedang" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Selesai" name="cleaned" domain="[('state','=','cleaned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Pelanggan" context="{'group_by':'customer_id'}"/>
                    <filter string="Status" context="{'group_by':'state'}"/>
                    <filter string="Jenis Pembersihan" context="{'group_by':'cleaning_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>

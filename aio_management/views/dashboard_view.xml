<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hudson_pool_dashboard_view" model="ir.ui.view">
        <field name="name">hudson.pool.dashboard.kanban</field>
        <field name="model">hudson.pool.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_hudson_pool_dashboard" default_group_by="" create="false" quick_create="false">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <strong>AIO Management</strong>
                                    <div class="text-muted">Divisi Kolam Renang</div>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="me-2">Admin: <t t-esc="env.user.name"/></span>
                                    <button type="action" class="btn btn-link" name="action_open_user_profile">Setting</button>
                                    <a class="btn btn-secondary ms-2" t-attf-href="/web/session/logout">Logout</a>
                                </div>
                            </div>

                            <div class="o_kanban_images">
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <div class="o_kanban_primary o_stat_card">
                                            <div class="o_stat_value" t-esc="record.customer_count.raw_value"/>
                                            <div class="o_stat_text">Pelanggan</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="o_stat_card">
                                            <div class="o_stat_value" t-esc="record.pool_count.raw_value"/>
                                            <div class="o_stat_text">Kolam</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="o_stat_card">
                                            <div class="o_stat_value" t-esc="record.active_jobs.raw_value"/>
                                            <div class="o_stat_text">Tugas Aktif</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-12 col-md-4">
                                    <div class="o_kanban_primary o_stat_card">
                                        <div class="o_stat_text">Uang Masuk</div>
                                        <div class="o_stat_value" t-esc="formatMonetary(record.income_total.raw_value)"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_stat_card">
                                        <div class="o_stat_text">Uang Keluar</div>
                                        <div class="o_stat_value" t-esc="formatMonetary(record.expense_total.raw_value)"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_stat_card">
                                        <div class="o_stat_text">Saldo</div>
                                        <div class="o_stat_value" t-esc="formatMonetary(record.balance_total.raw_value)"/>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 o_hudson_shortcuts">
                                <div class="btn-group" role="group">
                                    <button type="action" class="btn btn-primary" name="action_open_customers">Data Customer</button>
                                    <button type="action" class="btn btn-secondary" name="action_open_pools">Data Kolam</button>
                                    <button type="action" class="btn btn-secondary" name="action_open_cleaning_jobs">Pembersihan</button>
                                    <button type="action" class="btn btn-secondary" name="action_open_finance">Laporan Keuangan</button>
                                </div>
                                <div class="text-muted mt-2">Dashboard bertindak sebagai shortcut ke fitur utama.</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
